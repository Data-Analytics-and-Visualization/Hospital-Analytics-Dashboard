# Hospital Patient Data Analysis
# Aggregate descriptive analysis and charts. This notebook avoids printing patient-level records.
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

df = pd.read_csv('cleaned_hospital_patient_data.csv')
print('Shape:', df.shape)
print('Columns:', list(df.columns))
# Data quality
profile = pd.DataFrame({'dtype': df.dtypes.astype(str), 'non_missing': df.notna().sum(), 'missing': df.isna().sum(), 'unique': df.nunique()})
display(profile)
print('Exact duplicate rows:', df.duplicated().sum())
# Numeric summary
display(df.select_dtypes(include='number').describe().T)
# Condition counts
df['Condition'].value_counts().plot(kind='bar', figsize=(8,4), title='Patient Records by Condition')
plt.xlabel('Condition'); plt.ylabel('Records'); plt.xticks(rotation=35); plt.tight_layout(); plt.show()
# Age distribution
df['Age'].dropna().plot(kind='hist', bins=18, edgecolor='black', figsize=(8,4), title='Age Distribution')
plt.xlabel('Age'); plt.tight_layout(); plt.show()
# Average length of stay by condition
df.groupby('Condition')['Length_of_Stay'].mean().sort_values().plot(kind='barh', figsize=(8,4), title='Average Length of Stay by Condition')
plt.xlabel('Average length of stay'); plt.tight_layout(); plt.show()
# Average cost by condition
df.groupby('Condition')['Total_Cost'].mean().sort_values().plot(kind='barh', figsize=(8,4), title='Average Total Cost by Condition')
plt.xlabel('Average total cost'); plt.tight_layout(); plt.show()
# Readmission and outcomes
for col in ['Readmission', 'Outcome', 'Insurance_Claimed']:
    df[col].value_counts().plot(kind='bar', figsize=(7,4), title=col)
    plt.xlabel(col); plt.ylabel('Records'); plt.tight_layout(); plt.show()
# Satisfaction scores
df['Satisfaction'].value_counts().sort_index().plot(kind='bar', figsize=(7,4), title='Patient Satisfaction Scores')
plt.xlabel('Satisfaction score'); plt.ylabel('Records'); plt.tight_layout(); plt.show()